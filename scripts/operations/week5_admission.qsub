#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -N pose_v3_admission
#$ -l h_rt=12:00:00
#$ -pe omp 4
#$ -l mem_per_core=8G
#$ -v POSE_EMBED_DATA_ROOT,POSE_EMBED_ARTIFACT_ROOT,POSE_EMBED_MANIFEST_SET
# Pass the transferred wrapper path first, followed by its arguments.
# Submit with -o pointing to the canonical artifact logs directory.
set -euo pipefail
umask 077
: "${JOB_ID:?Submit through Grid Engine}"
: "${TMPDIR:?Scheduler temporary directory required}"
[[ ${NSLOTS:-0} == 4 ]] || { printf 'Exactly four CPU slots required.\n' >&2; exit 2; }
[[ $# -gt 0 ]] || { printf 'Pass the admission wrapper path and arguments.\n' >&2; exit 2; }
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec .venv/bin/python3.11 "$@"
