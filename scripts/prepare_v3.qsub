#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -N pose_v3_prepare
#$ -l h_rt=02:00:00
#$ -pe omp 4
#$ -l mem_per_core=8G
#$ -v POSE_EMBED_DATA_ROOT,POSE_EMBED_ARTIFACT_ROOT,POSE_EMBED_MANIFEST_SET
# Submit with -o "$POSE_EMBED_ARTIFACT_ROOT/logs" so scheduler logs remain
# outside the clean release. Every attempt and failure is retained.
set -euo pipefail
set -o noclobber
umask 077
[[ $# == 0 ]] || { printf 'Usage: prepare_v3.qsub\n' >&2; exit 2; }
: "${JOB_ID:?Submit through Grid Engine}"
: "${TMPDIR:?Grid Engine node-local temporary directory required}"
: "${POSE_EMBED_DATA_ROOT:?Licensed input root required}"
: "${POSE_EMBED_ARTIFACT_ROOT:?Canonical artifact root required}"
: "${POSE_EMBED_MANIFEST_SET:?Historical adopted manifest bundle required}"
export OMP_NUM_THREADS="${NSLOTS:-4}" MKL_NUM_THREADS="${NSLOTS:-4}"
export OPENBLAS_NUM_THREADS="${NSLOTS:-4}" CUBLAS_WORKSPACE_CONFIG=:4096:8
if [[ -n "$(git status --porcelain)" ]]; then
  printf 'A clean committed checkout is required.\n' >&2
  exit 2
fi
export UV_CACHE_DIR="$TMPDIR/pose-embed-uv-cache" UV_LINK_MODE=copy UV_NO_PROGRESS=1
uv sync --locked --group dev --python 3.11
v3_stamp=$(date -u +%Y%m%dT%H%M%SZ)
v3_attempt="$POSE_EMBED_ARTIFACT_ROOT/study-v3/preparation/${v3_stamp}-${JOB_ID}"
mkdir -p "$(dirname "$v3_attempt")"
# Keep launcher evidence separate; prepare owns creation of its scientific output.
v3_launcher="${v3_attempt}-launcher"
mkdir "$v3_launcher"
trap 'v3_code=$?; printf "exit_status=%s\n" "$v3_code" > "$v3_launcher/scheduler-exit.txt"' EXIT
git rev-parse HEAD > "$v3_launcher/release.txt"
LC_ALL=C pquota textconv > "$v3_launcher/project-quota.txt"
.venv/bin/python - "$v3_launcher/project-quota.txt" <<'PYQUOTA'
import shutil, sys
from pathlib import Path
from pose_embed.dataset_seal import canonical_artifact_root, require_dataset_unopened
from pose_embed.motionbert_reproducibility import parse_project_quota
root = canonical_artifact_root()
require_dataset_unopened(require_registry=True)
quota = parse_project_quota(Path(sys.argv[1]).read_text(), root)
# Auxiliary packaging plus staging stays inside a bounded 3 GB envelope.
if min(shutil.disk_usage(root).free, quota["free_bytes"]) < 200 * 2**30 + 1.25 * 3_000_000_000:
    raise ValueError("v3 preparation would cross its storage reserve")
PYQUOTA
.venv/bin/python scripts/verify_workspace.py
.venv/bin/python scripts/fetch_upstreams.py --check --name MotionBERT
# Root registration is a separate audited command; this job cannot omit roots.
.venv/bin/pose-embed study-v3 prepare \
  --manifest-set "$POSE_EMBED_MANIFEST_SET" --output-dir "$v3_attempt"
.venv/bin/pose-embed study-v3 rebind-manifests \
  --protocol-config "$v3_attempt/protocol.v3.yaml" \
  --historical-manifest-set "$POSE_EMBED_MANIFEST_SET" \
  --output-dir "$v3_attempt/manifests"
.venv/bin/pose-embed study-v3 freeze-design \
  --protocol-config "$v3_attempt/protocol.v3.yaml" \
  --manifest-set "$v3_attempt/manifests/manifest-set.json" \
  --recorded-by "researcher-authorized Codex Week 3 preparation"
printf 'V3_PREPARATION_COMPLETE=%s\n' "$v3_attempt"
